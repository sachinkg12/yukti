# Yukti explanation evaluation — API keys
# Copy this file to .env (already gitignored) and fill in real keys.
# Or just export these variables in your shell before running the eval.

# OpenAI (GPT-4o, GPT-4o-mini)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (Claude Sonnet, Claude Haiku)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini 2.5 Flash, Gemini 2.5 Pro)
# Get from: https://aistudio.google.com/apikey
# Free tier available.
GOOGLE_API_KEY=...

# OPTIONAL — Together AI (Llama-3.1-70B, Qwen-72B). Skip if not using open weight models.
# Get from: https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=...
